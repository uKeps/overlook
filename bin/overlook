#!/usr/bin/env bun
// overlook: talk to the cards wired to this terminal on the Overlook canvas (Overlook puts it on the PATH of every
// canvas terminal, with OVERLOOK_URL, OVERLOOK_PANE and OVERLOOK_TOKEN in the environment).
//   overlook peers                    the cards wired to this one
//   overlook send <card> <message…>   type the message into that card as a prompt (or pipe it in on stdin)
//   overlook read <card> [lines]      what that card's screen shows
//   overlook spawn <agent> [--cwd dir] [task…]   open a new card wired to this one (an agent with that task, or `shell`)
//   overlook note <text…>             put a note card on the canvas, wired to this one
//   overlook context [--new|--all]   the notes wired to this card (claude's hooks: --new only new or changed ones, --all
//                                    all of them; both print nothing when there is nothing)
//   overlook todo [task…]             add a to-do ("pagar o servidor dia 15 todo mês"), or list today's
// <card> is a card id or part of its name, as `overlook peers` prints them.
const { OVERLOOK_URL: url, OVERLOOK_PANE: from, OVERLOOK_TOKEN: token } = process.env;
const [cmd, card, ...rest] = process.argv.slice(2);
const usage = "usage: overlook peers | overlook send <card> <message> | overlook read <card> [lines] | overlook spawn <agent> [--cwd dir] [task] | overlook note <text> | overlook context | overlook todo [task]";
// To-dos work from any terminal on this machine (the canvas's variables aren't needed).
if (cmd === "todo") {
  const base = url || `http://127.0.0.1:${process.env.PORT || 3333}`, text = [card, ...rest].filter(Boolean).join(" ").trim();
  const r = await fetch(base + (text ? "/api/todos/add" : "/api/todos"), text ? { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ text }) } : {})
    .catch(() => { console.error(`overlook: Overlook isn't running at ${base}`); process.exit(1); });
  if (!r.ok) { console.error(`overlook: ${await r.text()}`); process.exit(1); }
  const { todo, todos, today } = await r.json();
  const show = (t: any) => `${t.due && today && t.due < today ? `[late ${t.due}] ` : ""}${t.time ? `${t.time} ` : ""}${t.text}${t.due && !text ? "" : t.due ? ` · ${t.due}` : ""}${t.repeat ? ` (${t.repeat})` : ""}`;
  if (text) console.log(`added: ${show(todo)}`);
  else {
    const open = todos.filter((t: any) => !t.done), now = open.filter((t: any) => t.due && t.due <= today);
    console.log(now.map(show).join("\n") || "Nothing for today.");
    if (open.length > now.length) console.log(`(${open.length - now.length} more upcoming or without a date)`);
  }
  process.exit(0);
}
// The hook form runs before each of the user's prompts: whatever goes wrong, it prints nothing and exits 0 (an exit 2
// would block the prompt).
if (cmd === "context") {
  const fresh = card === "--new", hook = fresh || card === "--all";
  const r = url && from && token ? await fetch(url + "/api/pty/context", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ from, token, fresh }) }).catch(() => null) : null;
  const items: any[] = r?.ok ? (await r.json()).items : [];
  if (items.length) console.log(`Notes the user wired to this card on the Overlook canvas, as context for the work${fresh ? " (new or changed since you last saw them)" : ""}:\n\n`
    + items.map((i) => `### ${i.path ? `Vault note: ${i.path}` : `Note "${i.name}"`}\n${i.text}`).join("\n\n"));
  else if (!hook) console.log(r?.ok ? "No notes are wired to this card." : "overlook: run this inside a terminal card on the Overlook canvas");
  process.exit(0);
}
if (!url || !from || !token) { console.error("overlook: run this inside a terminal card on the Overlook canvas"); process.exit(2); }
async function call(path: string, body: object) {
  const r = await fetch(url + path, { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ from, token, ...body }) }).catch((e) => { console.error(`overlook: ${e.message}`); process.exit(1); });
  const text = await r.text();
  if (!r.ok) { console.error(`overlook: ${text}`); process.exit(1); }
  return JSON.parse(text);
}
if (cmd === "peers") {
  const { peers } = await call("/api/pty/peers", {});
  console.log(peers.length ? peers.map((p: any) => `${p.id}\t${p.name}${p.running ? "" : " (stopped)"}`).join("\n") : "No cards are wired to this one. Ask the user to draw a wire between the cards on the canvas.");
} else if (cmd === "send" && card) {
  const text = rest.length ? rest.join(" ") : await Bun.stdin.text();
  await call("/api/pty/send", { to: card, text });
  console.log("sent");
} else if (cmd === "read" && card) {
  const r = await call("/api/pty/read", { to: card, lines: Number(rest[0]) || 60 });
  console.log(`--- ${r.name} (${r.id})\n${r.text}`);
} else if (cmd === "spawn") {
  const at = rest.indexOf("--cwd"), dir = at >= 0 ? rest.splice(at, 2)[1] : "";
  const { resolve } = await import("node:path");
  const r = await call("/api/pty/spawn", { agent: card ?? "", cwd: resolve(dir || "."), prompt: rest.join(" ") });
  console.log(r.queued ? `${r.id}: queued, it opens when the Overlook canvas is showing this card` : `${r.id}: opened and wired to this card`);
} else if (cmd === "note" && card) {
  const r = await call("/api/pty/spawn", { note: [card, ...rest].join(" ") });
  console.log(r.queued ? "queued, it shows when the Overlook canvas is showing this card" : "note added");
} else { console.error(usage); process.exit(2); }
