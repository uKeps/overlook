[
  {"id": "claude", "name": "Claude Code", "process": "claude", "run": ["claude", "-p", "{prompt}", "--permission-mode", "acceptEdits"]},
  {"id": "agy", "name": "Antigravity", "process": "agy", "run": ["agy", "-p", "{prompt}", "--mode", "auto", "--print-timeout", "10m"]},
  {"id": "codex", "name": "Codex", "process": "codex", "run": ["codex", "exec", "{prompt}"]},
  {"id": "claude-api", "name": "Claude (API)", "api": "anthropic", "model": "claude-opus-5-5", "key": "ANTHROPIC_API_KEY"},
  {"id": "openrouter", "name": "OpenRouter", "api": "openai", "url": "https://openrouter.ai/api/v1", "model": "openai/gpt-5", "key": "OPENROUTER_API_KEY"},
  {"id": "ollama", "name": "Ollama (local)", "api": "openai", "url": "http://127.0.0.1:11434/v1", "model": "llama3.1"}
]
