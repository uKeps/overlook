# Path to your Obsidian vault. Try the bundled demo first: ./example-vault
VAULT_DIR=./example-vault
# Optional: folder of images for the cards when Pinterest is off
ART_DIR=
# Optional: HTTP port (the alternate UI listens on PORT+2)
PORT=3333

# Optional: Pinterest OAuth app (only needed for private boards; see README)
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
PINTEREST_ACCESS_TOKEN=
PINTEREST_REFRESH_TOKEN=
PINTEREST_EXPIRES_AT=
