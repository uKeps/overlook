# Path to your Obsidian vault. Try the bundled demo first: ./example-vault
VAULT_DIR=./example-vault
# Folder and section names your vault uses: en (2 Daily, ## Focus...) or pt (2 Diário, ## Foco de hoje...)
VAULT_LANG=en
# Optional: a folder of your own photos for the cards (also settable in the Images page)
ART_DIR=
# Optional: HTTP port
PORT=3333

# Optional: Pinterest OAuth app (only needed for private boards; see README)
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
PINTEREST_ACCESS_TOKEN=
PINTEREST_REFRESH_TOKEN=
PINTEREST_EXPIRES_AT=

# Optional: keys for API agents in agents.json (each entry names the variable it reads)
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
